<mjml>
  <mj-head>
    <mj-attributes>
      <mj-class name="primary-color" color="#2749a2"></mj-class>
      <mj-all padding="0" />
      <mj-class name="heading-container" padding-bottom="8px" />
      <mj-class name="not-the-first-heading-container" padding-top="24px" />
      <mj-class
        name="heading-column"
        padding="6px 8px"
        background-color="#f6f8f7"
        border-radius="4px"
      />
      <mj-class
        name="heading-text"
        font-family="'Helvetica Neue', Helvetica, Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif"
        font-weight="600"
        font-size="15px"
        line-height="24px"
        color="#2749a2"
        letter-spacing="1px"
      />
      <mj-class
        name="data-table"
        table-layout="fixed"
        width="100%"
        font-family="'Helvetica Neue', Helvetica, Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif"
      />
    </mj-attributes>
    <mj-style>
      .header-border { border-top: 1px solid rgba(0, 0, 0, 0.1); border-left:
      1px solid rgba(0, 0, 0, 0.1); border-right: 1px solid rgba(0, 0, 0, 0.1);
      } .content-border { border-bottom: 1px solid rgba(0, 0, 0, 0.1);
      border-left: 1px solid rgba(0, 0, 0, 0.1); border-right: 1px solid rgba(0,
      0, 0, 0.1); } .data-table table { background:rgb(255, 255, 255); border-radius: 4px;
      text-shadow: 1px 1px 0px #fff; box-shadow: 0 1px 2px #d1d1d1; }
      .data-table caption { color: #4B5563; padding: 8px; }
      .data-table table th { padding: 8px 0; background: #E5E7EB; color: #4B5563; } .data-table
      table th:first-child { text-align: left; padding-left: 8px; } .data-table
      table tr:first-child th:first-child { border-top-left-radius: 4px; }
      .data-table table tr:first-child th:last-child { border-top-right-radius:
      4px; } .data-table table tr { text-align: left; } .data-table table
      td:first-child { padding-left: 8px; text-align: left; border-left: 0; }
      .data-table table td { padding: 8px 8px 8px 0; background: #F9FAFB; color: #4B5563; }
      .data-table tr:nth-child(even) td { background: #F3F4F6; } .data-table
      tr:last-child td { border-bottom: 0; } .data-table tr:last-child
      td:first-child { border-bottom-left-radius: 4px; } .data-table
      tr:last-child td:last-child { border-bottom-right-radius: 4px; }
      .data-table table tr:hover td { background: #EDF2F7; }
    </mj-style>
  </mj-head>
  <mj-body width="720px">
    <!-- Spacer -->
    <mj-section>
      <mj-column>
        <mj-spacer height="24px" />
      </mj-column>
    </mj-section>
    <!-- Header -->
    <mj-section
      background-color="#ffffff"
      border-radius="8px 8px 0 0"
      css-class="header-border"
      padding="80px 0 8px 0"
    >
      <mj-column width="80%">
        <mj-text
          align="center"
          font-family="'Helvetica Neue', Helvetica, Arial, 'Lantinghei SC', 'PingFang SC', 'Microsoft YaHei', sans-serif"
          font-size="32px"
          font-weight="600"
          line-height="38px"
          letter-spacing="0.1em"
          mj-class="primary-color"
        >
          个性化广告和个性化内容开关
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- Content -->
    <mj-wrapper
      css-class="content-border"
      border-radius="0 0 8px 8px"
      background-color="#ffffff"
      padding="0 30px 30px 30px"
    >
      <!-- General -->
      <mj-section padding="24px 0">
        <mj-column>
          <mj-text
            font-family="'Helvetica Neue', Helvetica, Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif"
            font-size="14px"
            line-height="16px"
          >
            <p style="margin: 0 0 8px 0">
              测试结论: <span style="color: green">通过</span>
            </p>
            <p style="margin: 8px 0">项目名称: 个性化广告和个性化内容开关</p>
            <p style="margin: 8px 0">测试人员: Raigor</p>
            <p style="margin: 8px 0 0 0">开发人员: Steam</p>
          </mj-text>
        </mj-column>
      </mj-section>
      <!-- 项目统计 -->
      <mj-section mj-class="heading-container">
        <mj-column mj-class="heading-column">
          <mj-text mj-class="heading-text">
            <p style="margin: 0; text-shadow: 0px 0px #2749a2;">项目统计</p>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column>
          <mj-table mj-class="data-table" css-class="data-table">
            <thead>
              <tr>
                <th scope="col" width="20%">统计项</th>
                <th scope="col" width="20%">预期</th>
                <th scope="col" width="20%">实际</th>
                <th scope="col" width="40%">偏差原因</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>提测时间</td>
                <td>2024.6.12</td>
                <td>2024.6.12</td>
                <td></td>
              </tr>
              <tr>
                <td>测试完成时间</td>
                <td>2024.6.12</td>
                <td>2024.6.12</td>
                <td></td>
              </tr>
              <tr>
                <td>测试工时（天）</td>
                <td>1</td>
                <td>2</td>
                <td>一些说明文字</td>
              </tr>
              <tr>
                <td>项目工时（天）</td>
                <td>3.3</td>
                <td>3.3</td>
                <td></td>
              </tr>
              <tr>
                <td>开发预估工时（天）</td>
                <td>5</td>
                <td>5</td>
                <td></td>
              </tr>
            </tbody>
          </mj-table>
        </mj-column>
      </mj-section>
      <!-- 需求变更 -->
      <mj-section mj-class="heading-container not-the-first-heading-container">
        <mj-column mj-class="heading-column">
          <mj-text mj-class="heading-text">
            <p style="margin: 0; text-shadow: 0px 0px #2749a2;">需求变更</p>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column>
          <mj-table mj-class="data-table" css-class="data-table">
            <thead>
              <tr>
                <th scope="col" width="5%">ID</th>
                <th scope="col" width="95%">变更内容</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>1</td>
                <td>一些文字说明变更内容</td>
              </tr>
              <tr>
                <td>2</td>
                <td>另外一些文字说明变更内容</td>
              </tr>
            </tbody>
          </mj-table>
        </mj-column>
      </mj-section>
      <!-- 风险 -->
      <mj-section mj-class="heading-container not-the-first-heading-container">
        <mj-column mj-class="heading-column">
          <mj-text mj-class="heading-text">
            <p style="margin: 0; text-shadow: 0px 0px #2749a2;">风险</p>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column>
          <mj-text> 一些风险的说明。 </mj-text>
        </mj-column>
      </mj-section>
      <!-- 建议 -->
      <mj-section mj-class="heading-container not-the-first-heading-container">
        <mj-column mj-class="heading-column">
          <mj-text mj-class="heading-text">
            <p style="margin: 0; text-shadow: 0px 0px #2749a2;">建议</p>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column>
          <mj-text> 一些建议的说明。 </mj-text>
        </mj-column>
      </mj-section>
      <!-- bug 统计 -->
      <mj-section mj-class="heading-container not-the-first-heading-container">
        <mj-column mj-class="heading-column">
          <mj-text mj-class="heading-text">
            <p style="margin: 0; text-shadow: 0px 0px #2749a2;">Bug 统计</p>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column>
          <mj-table mj-class="data-table" css-class="data-table">
            <thead>
              <tr>
                <th scope="col" width="40%">指标</th>
                <th scope="col" width="10%">数据</th>
                <th scope="col" width="50%">备注</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>阻塞性 bug</td>
                <td>0</td>
                <td></td>
              </tr>
              <tr>
                <td>阻塞性 bug 修复时长超过 1 天的数量</td>
                <td>1</td>
                <td></td>
              </tr>
              <tr>
                <td>二次缺陷数量</td>
                <td>0</td>
                <td></td>
              </tr>
              <tr>
                <td>总 bug 数量</td>
                <td>25</td>
                <td>一些说明文字</td>
              </tr>
            </tbody>
          </mj-table>
        </mj-column>
      </mj-section>
      <mj-section padding-top="8px">
        <mj-column>
          <mj-image
            src="https://quickchart.io/chart?c={type:'line',data:{labels:['2024-07-01','2024-07-02','2024-07-03','2024-07-04','2024-07-05','2024-07-06','2024-07-07'],datasets:[{label:'实际剩余 bug',data:[50,45,40,35,30,25,20],borderColor:'rgba(255, 99, 132, 1)',fill:false},{label:'计划剩余 bug',data:[50,40,30,20,10,5,0],borderColor:'rgba(54, 162, 235, 1)',fill:false}]},options:{title:{display:true,text:'Bug 燃尽图'},scales:{xAxes:[{type:'time',time:{unit:'day'}}],yAxes:[{ticks:{beginAtZero:true}}]}}}"
            alt="Chart"
            align="left"
            border="1px solid #ededed"
            border-radius="4px"
          />
        </mj-column>
      </mj-section>
      <!-- 测试覆盖的接口 -->
      <mj-section mj-class="heading-container not-the-first-heading-container">
        <mj-column mj-class="heading-column">
          <mj-text mj-class="heading-text">
            <p style="margin: 0; text-shadow: 0px 0px #2749a2;">测试覆盖的接口</p>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column>
          <mj-table mj-class="data-table" css-class="data-table">
            <thead>
              <tr>
                <th scope="col" width="5%">ID</th>
                <th scope="col" width="95%">接口 URL</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>1</td>
                <td>/iot/api/accessories/v1/addWaterSoftner</td>
              </tr>
              <tr>
                <td>2</td>
                <td>/iot/api/accessories/v1/deleteWaterSoftner</td>
              </tr>
              <tr>
                <td>3</td>
                <td>/iot/api/accessories/v1/replaceWaterSoftner</td>
              </tr>
              <tr>
                <td>4</td>
                <td>/iot/api/accessories/v1/replaceWaterSoftner</td>
              </tr>
            </tbody>
          </mj-table>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <!-- Spacer -->
    <mj-section>
      <mj-column>
        <mj-spacer height="24px" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
